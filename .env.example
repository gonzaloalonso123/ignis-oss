# ============================================================================
# Ignis OSS — Local Environment Configuration
# Copy this file to `.env` (`cp .env.example .env`) OR configure keys directly
# inside the web UI via Protected Core Control (⌘. -> AI Brain / Env Vault).
# ============================================================================

# Provide at least one AI provider API key:
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# Optional default provider ("anthropic" | "openai" | "google")
IGNIS_DEFAULT_PROVIDER="anthropic"

# Optional default model ID override
# Examples: "claude-opus-5-5", "claude-sonnet-4-5", "gpt-6-astra", "gemini-4-argon"
IGNIS_DEFAULT_MODEL="claude-opus-5-5"
